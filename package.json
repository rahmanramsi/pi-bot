{
  "name": "pi-bot",
  "version": "0.1.5",
  "description": "A local-first macOS workspace for Pi coding agents.",
  "author": "Rahman Ramsi",
  "homepage": "https://github.com/rahmanramsi/pi-bot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahmanramsi/pi-bot.git"
  },
  "bugs": {
    "url": "https://github.com/rahmanramsi/pi-bot/issues"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "verify:renderer": "node scripts/check-packaged-renderer.mjs",
    "smoke:packaged": "node scripts/run-packaged-smoke.mjs",
    "dist": "npm run build && npm run verify:renderer && electron-builder --mac --arm64",
    "dist:win": "npm run build && npm run verify:renderer && electron-builder --win --x64"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@base-ui/react": "^1.7.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "10.0.4",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.17.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "tw-animate-css": "^1.4.0",
    "vite": "8.2.1",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.rahmanramsi.pibot",
    "productName": "Pi Bot",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "electron",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "PiBot-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PiBot-${version}-${arch}-setup.${ext}"
    }
  }
}
